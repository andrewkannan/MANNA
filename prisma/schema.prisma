generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         String   @default("USER")
  createdAt    DateTime @default(now())

  devices       Device[]
  bookmarks     Bookmark[]
  reviewLogs    ReviewLog[]
  subscriptions PushSubscription[]
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model Device {
  id             String   @id @default(uuid())
  macAddress     String   @unique // Used by ESP32 to identify itself
  pairingCode    String?  // Temporary 6-digit code for linking
  name           String?
  ownerId        String?  // Links the device to a user
  activeVerseId  String?  // The ID of the currently displayed bookmark
  autoRotate     Boolean  @default(false)
  rotateInterval Int      @default(60) // In minutes
  lastRotatedAt  DateTime @default(now())

  owner          User?    @relation(fields: [ownerId], references: [id])
  createdAt      DateTime @default(now())
  
  // Link to active verse
  activeVerse    Verse?   @relation(fields: [activeVerseId], references: [id])
}

model Verse {
  id        String   @id @default(uuid())
  reference String   // e.g. "Genesis 1:1"
  text      String
  book      String
  chapter   Int
  verse     Int
  version   String   @default("WEB")
  
  bookmarks Bookmark[]
  devices   Device[]

  @@unique([reference, version])
}

model Bookmark {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  verseId          String
  verse            Verse    @relation(fields: [verseId], references: [id])
  
  status           String   @default("NEW") 
  dueDate          BigInt   @default(0)
  lastReviewed     BigInt?
  difficulty       Float    @default(1.0)
  streak           Int      @default(0)
  
  tamilExplanation String?
  personalNotes    String?
  themes           String   @default("[]") 
  categoryId       String?
  imageUrl         String   @default("/images/world_map.jpg")
  
  createdAt        DateTime @default(now())
  
  @@unique([userId, verseId])
}

model ReviewLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  date      String   // Stored as "YYYY-MM-DD" to easily group by day
  count     Int      @default(0)

  @@unique([userId, date])
}
