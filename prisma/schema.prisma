generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         String   @default("USER")
  createdAt    DateTime @default(now())

  devices      Device[]
  bookmarks    Bookmark[]
}

model Device {
  id          String   @id @default(uuid())
  pairingCode String?  @unique // 6-digit code displayed on screen
  name        String?
  ownerId     String?
  owner       User?    @relation(fields: [ownerId], references: [id])
  createdAt   DateTime @default(now())
  
  // Link to active verse
  activeVerseId String?
  activeVerse   Verse? @relation(fields: [activeVerseId], references: [id])
}

model Verse {
  id        String   @id @default(uuid())
  reference String   @unique // e.g. "Genesis 1:1"
  text      String
  book      String
  chapter   Int
  verse     Int
  version   String   @default("WEB")
  
  bookmarks Bookmark[]
  devices   Device[]
}

model Bookmark {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  verseId          String
  verse            Verse    @relation(fields: [verseId], references: [id])
  
  status           String   @default("NEW") 
  dueDate          BigInt   @default(0)
  lastReviewed     BigInt?
  difficulty       Float    @default(1.0)
  streak           Int      @default(0)
  
  tamilExplanation String?
  personalNotes    String?
  themes           String   @default("[]") 
  categoryId       String?
  imageUrl         String   @default("/images/world_map.jpg")
  
  createdAt        DateTime @default(now())
  
  @@unique([userId, verseId])
}
